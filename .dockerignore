# Dependencias locales: se instalan dentro de la imagen.
node_modules/

# El build de TypeScript se genera dentro de la etapa builder.
dist/

# Secretos y configuración local: nunca deben entrar al contexto de build.
.env
.env.*

# Metadatos de Git.
.git/
.gitignore

# Herramientas y archivos que no se necesitan dentro de la imagen.
Dockerfile
docker-compose.yml
npm-debug.log*
coverage/
.vscode/
.idea/
